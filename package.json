{
  "name": "godot-runtime-mcp",
  "version": "3.0.0",
  "description": "Godot 4 .NET runtime debugging via shared CLI and standalone MCP stdio",
  "type": "module",
  "private": true,
  "bin": {
    "godot-mcp": "./bin/godot-mcp.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "tools:generate": "python3 scripts/generate-tools.py",
    "pack": "node bin/godot-mcp.js pack",
    "start": "node bin/godot-mcp.js mcp"
  },
  "license": "MIT"
}
